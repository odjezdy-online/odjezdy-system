[Unit]
Description=Odjezdy board on tty1
After=systemd-user-sessions.service network.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Environment=TZ=Europe/Prague
Environment=ODJEZDY_VT=tty1
ExecStart=/usr/bin/odjezdy-board-run
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StateDirectory=odjezdy
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
